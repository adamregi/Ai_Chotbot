# Local Ollama settings used for embeddings and optional chat fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Answer provider: nvidia (hosted) or ollama (local)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MAX_COMPLETION_TOKENS=1024
NVIDIA_MAX_RETRIES=2
NVIDIA_RETRY_DELAY_SECONDS=1
# Set true only when NVIDIA traffic must use HTTP(S)_PROXY from the environment.
NVIDIA_USE_ENV_PROXY=false
LLM_TIMEOUT_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
